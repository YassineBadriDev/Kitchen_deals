# Copy to vultr/.env (chmod 600). Never commit the real file.
INGEST_TOKEN=replace-with-rotated-token
AFFILIATE_AMAZON=tag=YOUR_AMAZON_TAG-20
AFFILIATE_BESTBUY=affid=YOUR_BESTBUY_ID
AFFILIATE_WALMART=affp1=YOUR_WALMART_ID&affilsrc=api
AFFILIATE_TARGET=ref=tgt_adv_xasd0002&AFID=YOUR_TARGET_ID
# Optional uptime monitoring (healthchecks.io ping URL)
HEALTHCHECK_URL=
