* text=auto

# Shell scripts and systemd units must stay LF (they run on the Linux VPS)
*.sh text eol=lf
vultr/kitchen-deals.service text eol=lf
vultr/kitchen-deals.timer text eol=lf

# GitHub Actions workflows are read by the runner, keep them LF
.github/workflows/*.yml text eol=lf

# Windows PowerShell helper stays LF-friendly too (used from bash-agnostic shells)
scripts/*.ps1 text eol=lf
