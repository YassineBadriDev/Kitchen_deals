{
  "name": "kitchen-deals-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Kitchen Deals Cloudflare Worker (plain JS, D1). Serves all HTML/API/SEO; Node scraper service pushes via /api/ingest.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute kitchen-deals-db --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
